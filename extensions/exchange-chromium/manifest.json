{
  "manifest_version": 3,
  "name": "ProfyPlan — обмен файлами",
  "version": "0.1.0",
  "description": "Локальный обмен пакетами ProfyPlan с папкой на этом компьютере",
  "permissions": [
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://profyplan.ru/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ProfyPlan — обмен файлами"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://profyplan.ru/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
