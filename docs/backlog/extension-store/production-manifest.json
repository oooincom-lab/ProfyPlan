{
  "manifest_version": 3,
  "name": "ProfyPlan — обмен файлами",
  "version": "0.1.0",
  "description": "Локальный обмен пакетами ProfyPlan с папкой на этом компьютере",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://profyplan.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ProfyPlan — обмен файлами",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://profyplan.ru/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
